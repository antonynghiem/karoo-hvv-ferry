<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:background="@android:color/transparent">

    <!-- Line + destination: "62 → Finkenwerder" -->
    <TextView
        android:id="@+id/ferry_destination"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/ferry_normal"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="62 → Finkenwerder"/>

    <!-- Departure pier: "Brücke 2" -->
    <TextView
        android:id="@+id/ferry_origin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textSize="11sp"
        android:textColor="@color/ferry_secondary"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Brücke 2"/>

    <!-- Current + next time: "18:34  ·  18:52" -->
    <TextView
        android:id="@+id/ferry_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="center_vertical"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="@color/ferry_normal"
        android:singleLine="true"
        android:text="18:34  ·  18:52"/>

</LinearLayout>
